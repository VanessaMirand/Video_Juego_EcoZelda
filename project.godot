[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jugador"
2d_physics/layer_3="enemigos"
2d_physics/layer_4="basura"
2d_physics/layer_5="proyectiles"
2d_physics/layer_6="muros_enemigos"

[physics]

